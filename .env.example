# Trimble ID (standalone sign-in only). Embedded Trimble Connect uses the Workspace token.
VITE_CONFIGURATION_ENDPOINT=https://id.trimble.com/.well-known/openid-configuration
VITE_CLIENT_ID=
VITE_SCOPES=openid
VITE_REDIRECT_URL=https://your-deployment.vercel.app/callback
VITE_LOGOUT_REDIRECT_URL=https://your-deployment.vercel.app/logout-callback
